APP_NAME=InsightBoard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=insightboard
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@insightboard.local"
MAIL_FROM_NAME="${APP_NAME}"

CSV_MAX_FILE_SIZE_MB=50
CSV_MAX_ROWS=100000
CSV_MAX_COLUMNS=100
CSV_IMPORT_CHUNK_SIZE=500

ANALYTICS_SERVICE_URL=http://127.0.0.1:8001
ANALYTICS_SERVICE_TOKEN=change-me-to-a-secure-random-token
ANALYTICS_TIMEOUT_SECONDS=180

VITE_APP_NAME="${APP_NAME}"
